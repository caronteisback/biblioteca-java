# Copy to .env and set your own values. .env is git-ignored; never commit it.
# Format: KEY=VALUE, no quotes, no inline comments (read by docker compose AND Spring Boot).

# SYS/SYSTEM administrator password (used by the container only).
ORACLE_PASSWORD=change_me_admin

# Application schema (created automatically in XEPDB1 on first start).
APP_USER=biblioteca
APP_USER_PASSWORD=change_me_app

# Host port mapped to the database (loopback only).
ORACLE_PORT=1521

# Key that signs the sign-in tokens: at least 32 characters, random, and secret. The application does not start without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_value_of_at_least_32_characters

# First librarian, created at startup only when there are no accounts yet (password of at least 12 characters).
# Leave both empty to start without any account.
BIBLIOTECA_ADMIN_EMAIL=
BIBLIOTECA_ADMIN_PASSWORD=
